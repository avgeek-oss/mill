{
  "name": "mill",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch apps/api/src/index.ts",
    "dev:web": "pnpm --filter @mill/web dev",
    "fixtures": "node --env-file=.env --import tsx tools/local-fixtures.ts",
    "build": "pnpm --filter @mill/web build && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/index.js",
    "migrate": "node --env-file=.env --import tsx packages/database/src/migrate-cli.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @mill/web exec tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=8 tests/*.test.ts tests/*.test.tsx",
    "verify": "pnpm docs:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:operations && pnpm test && pnpm audit --prod --audit-level=moderate && pnpm build",
    "backup": "bash tools/backup.sh",
    "restore": "bash tools/restore.sh",
    "recover-account": "node --env-file=.env --import tsx apps/api/src/auth/recovery-cli.ts",
    "docs:check": "node --import tsx tools/build-api-docs.ts --check && node tools/build-mintlify-docs.mjs --check && node tools/docs-check.mjs",
    "docs:build": "node --import tsx tools/build-api-docs.ts && node tools/build-mintlify-docs.mjs",
    "docs:dev": "pnpm docs:build && cd docs && npx --yes mint@4.2.986 dev --port 4174",
    "docs:screenshots": "node tools/capture-docs-screenshots.mjs",
    "docs:screenshots:check": "node tools/capture-docs-screenshots.mjs --check",
    "test:operations": "node --test tools/*.test.mjs",
    "verify:production": "node tools/production-verify.mjs",
    "test:quick": "node --import tsx --test tests/api-client-errors.test.ts tests/config.test.ts tests/date-time-formatters.test.ts tests/mention-caret.test.ts tests/password-capacity.test.ts tests/time-zone.test.ts"
  },
  "dependencies": {
    "@avgeek-oss/agent-core": "0.1.1",
    "@avgeek-oss/design-system": "1.4.0",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@hono/node-server": "2.0.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/server": "13.3.2",
    "file-type": "22.1.1",
    "hono": "4.13.14",
    "jose": "6.2.12",
    "nodemailer": "10.2.1",
    "pg": "8.16.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@avgeek-oss/mintlify-docs": "0.1.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
