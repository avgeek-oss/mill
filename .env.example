# Connection URL for your PostgreSQL database.
DATABASE_URL=
# Generate a separate application secret with openssl rand -hex 32.
# Preserve this value across upgrades and database restores.
# On a fresh database the API logs a separate installation setup secret.
MILL_SECRET=
# Public UI and API origins. Use HTTPS for remote access.
MILL_WEB_URL=http://localhost:4322
MILL_API_URL=http://localhost:4321

# Optional task attachments. Configure the endpoint, bucket and both keys together.
# Use a private bucket with CORS allowing the exact MILL_WEB_URL origin.
# Compose supplies only the public S3 endpoint to the UI, never these credentials.
# MILL_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MILL_S3_REGION=auto
# MILL_S3_BUCKET=mill-attachments
# MILL_S3_ACCESS_KEY_ID=
# MILL_S3_SECRET_ACCESS_KEY=
