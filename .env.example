# Generate secure local values: node tools/init-env.mjs
POSTGRES_PASSWORD=
MILL_SECRET=
MILL_BASE_URL=http://localhost:4321
MILL_PORT=4321
MILL_BIND_ADDRESS=127.0.0.1
# HTTP is allowed only for local loopback development. Use HTTPS for remote access.
ALLOW_INSECURE_LOCALHOST=true
# Exact proxy peer addresses as seen by Mill, comma-separated. Empty trusts no forwarded IPs.
MILL_TRUSTED_PROXY_IPS=
# Bound concurrent password hashing/verification and the waiting queue.
MILL_PASSWORD_VERIFY_CONCURRENCY=2
MILL_PASSWORD_VERIFY_QUEUE_LIMIT=16
# Used by pnpm dev with the development Compose override, not by production Compose.
DATABASE_URL=
# Optional immutable image reference for reviewed release artifacts.
MILL_IMAGE=mill:local
