# Set the version to a published Mill release, without the v prefix.
MILL_VERSION=1.0.1
# Required: different random values. Recommended: 64 hexadecimal characters each.
# A password manager or openssl rand -hex 32 can generate each value.
POSTGRES_PASSWORD=
MILL_SECRET=
MILL_BASE_URL=http://localhost:4321
MILL_PORT=4321
MILL_BIND_ADDRESS=127.0.0.1
# HTTP is allowed only for local loopback development. Use HTTPS for remote access.
ALLOW_INSECURE_LOCALHOST=true
# Compose expands POSTGRES_PASSWORD; percent-encode special characters in other database URLs.
DATABASE_URL=postgres://mill:${POSTGRES_PASSWORD}@postgres:5432/mill
# Only the UI needs the private API address. Never expose PostgreSQL or the API directly.
MILL_API_URL=http://api:4321
# Optional exact HTTPS proxy peer IPs as seen by the UI; empty ignores incoming forwarded IPs.
MILL_WEB_TRUSTED_PROXY_IPS=
# Optional overrides for immutable references from release mill-images.json.
# MILL_API_IMAGE=ghcr.io/avgeek-oss/mill-api@sha256:<api digest>
# MILL_WEB_IMAGE=ghcr.io/avgeek-oss/mill-web@sha256:<web digest>
# Exact trusted proxy peer addresses as seen by the API; empty trusts no forwarded IPs.
MILL_TRUSTED_PROXY_IPS=
# Bound concurrent password hashing/verification and the waiting queue.
MILL_PASSWORD_VERIFY_CONCURRENCY=2
MILL_PASSWORD_VERIFY_QUEUE_LIMIT=16

# Optional identity/invitation email. Host and from must be configured together.
# Remote SMTP requires STARTTLS (587) or implicit TLS (secure=true, usually 465).
MILL_SMTP_HOST=
MILL_SMTP_PORT=587
MILL_SMTP_SECURE=false
MILL_SMTP_USER=
MILL_SMTP_PASSWORD=
MILL_SMTP_FROM=
