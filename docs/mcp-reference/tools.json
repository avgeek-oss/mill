  {
    "name": "list_tasks",
    "method": "GET",
    "path": "/api/boards/:boardId/tasks",
    "description": "Search and filter tasks in one board. Combine q, status, assigneeId, priority and sort. Without a status filter, done and wont_do tasks are hidden after 24 hours in that status. Set status explicitly to include older tasks in that status. Tasks are sorted by priority from urgent through none by default; status sort follows backlog, todo, in_progress, in_review, done, wont_do. Maximum 100 results per page, with total matching tasks and the current revision. Use either cursor continuation or a positive page number. Cursor cannot be combined with page or revision. Page requests clamp to the last available page; send the returned revision on subsequent page requests to reject changed lists.",
    "readOnly": true,
    "administrator": false,
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "boardId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "q": { "type": "string", "maxLength": 300 },
        "status": {
          "type": "string",
          "enum": [
            "backlog",
            "todo",
            "in_progress",
            "in_review",
            "done",
            "wont_do"
          ]
        },
        "assigneeId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            { "type": "string", "const": "unassigned" }
          ]
        },
        "priority": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "urgent"]
        },
        "sort": {
          "type": "string",
          "enum": [
            "createdAt",
            "updatedAt",
            "dueDate",
            "priority",
            "status",
            "title"
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "type": "string", "maxLength": 1000 },
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
      },
      "required": ["boardId"],
      "additionalProperties": false
    }
  },
