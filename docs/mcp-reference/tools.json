  {
    "name": "create_attachment_upload",
    "method": "POST",
    "path": "/api/tasks/:taskId/attachments/uploads",
    "description": "Reserve an image/PDF attachment and obtain a short-lived private PUT URL. Upload file bytes directly to uploadUrl using the returned headers, then call complete_attachment. Treat URLs as temporary credentials; do not log them.",
    "readOnly": false,
    "administrator": false,
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "contentType": {
          "type": "string",
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif",
            "application/pdf"
          ]
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 20971520 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 }
      },
      "required": ["taskId", "fileName", "contentType", "sizeBytes"],
      "additionalProperties": false
    }
  },
