{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mill",
  "description": "Open-source, self-hosted task lists for teams, with REST and MCP clients.",
  "logo": {
    "light": "/assets/mill-mark.png",
    "dark": "/assets/mill-mark.png",
    "href": "/"
  },
  "favicon": "/assets/mill-favicon.png",
  "colors": {
    "primary": "#704628",
    "light": "#c89b6d",
    "dark": "#704628"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "interaction": {
    "drilldown": false
  },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Introduction",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["overview"]
          },
          {
            "group": "Self-hosting",
            "pages": [
              {
                "group": "Installation",
                "icon": "network",
                "pages": [
                  "installation",
                  "installation/docker-compose",
                  "installation/towbar"
                ]
              },
              "configuration",
              "security",
              "backup",
              "upgrades",
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "dropdown": "Using Mill",
        "icon": "clipboard-list",
        "groups": [
          {
            "group": "Common Concepts",
            "pages": [
              "boards",
              "task-lists",
              "task-details",
              "task-attachments",
              "notifications"
            ]
          },
          {
            "group": "Accounts and teams",
            "pages": ["authentication"]
          }
        ]
      },
      {
        "dropdown": "API & MCP",
        "icon": "plug",
        "groups": [
          {
            "group": "Connect a client",
            "pages": ["api-keys", "mcp-connections"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/avgeek-oss/mill"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/overview"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/avgeek-oss/mill"
    },
    "links": [
      {
        "header": "Documentation",
        "items": [
          {
            "label": "About Mill",
            "href": "/overview"
          },
          {
            "label": "Self-hosting",
            "href": "/installation"
          },
          {
            "label": "Configuration",
            "href": "/configuration"
          },
          {
            "label": "Changelog",
            "href": "https://github.com/avgeek-oss/mill/releases"
          }
        ]
      },
      {
        "header": "Open Source",
        "items": [
          {
            "label": "GitHub Source",
            "href": "https://github.com/avgeek-oss/mill"
          },
          {
            "label": "License Terms",
            "href": "https://github.com/avgeek-oss/mill/blob/main/LICENSE"
          },
          {
            "label": "OSS Philosophy",
            "href": "https://github.com/avgeek-oss/.github/blob/main/profile/README.md"
          }
        ]
      },
      {
        "header": "Other OSS Projects",
        "items": [
          {
            "label": "Towbar",
            "href": "https://www.towbar.dev"
          },
          {
            "label": "Posted",
            "href": "https://www.posted.cc"
          },
          {
            "label": "Rootset",
            "href": "https://www.rootset.app"
          }
        ]
      },
      {
        "header": "More links",
        "items": [
          {
            "label": "Company website",
            "href": "https://www.avgeek.ltd"
          },
          {
            "label": "Write to us",
            "href": "mailto:support@avgeek.ltd"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://www.mill.fyi",
      "og:image": "https://www.mill.fyi/assets/mill-social.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "og:image:alt": "Mill \u2014 Open-source task lists for teams",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://www.mill.fyi/assets/mill-social.png",
      "twitter:image:alt": "Mill \u2014 Open-source task lists for teams"
    },
    "organization": {
      "name": "Mill",
      "url": "https://www.mill.fyi",
      "logo": "https://www.mill.fyi/assets/mill-mark.png",
      "sameAs": ["https://github.com/avgeek-oss/mill"]
    }
  },
  "redirects": [
    {
      "source": "/getting-started",
      "destination": "/boards"
    },
    {
      "source": "/workflows",
      "destination": "/task-details"
    },
    {
      "source": "/clients",
      "destination": "/api-keys"
    },
    {
      "source": "/rest-reference",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/towbar-deployment",
      "destination": "/installation/towbar"
    },
    {
      "source": "/package-registry",
      "destination": "https://github.com/avgeek-oss/mill/blob/main/CONTRIBUTING.md"
    },
    {
      "source": "/operations",
      "destination": "/troubleshooting"
    },
    {
      "source": "/release-notes",
      "destination": "https://github.com/avgeek-oss/mill/releases"
    }
  ]
}
